+/* Experimental direct extent retention, matching the earlier candidate.
+ * O_SYNC diagnostics also persist the final length operation. */
+static int finish_direct_candidate(int fd, size_t bytes, int sync_write)
+{
+    struct stat st;
+    int rc;
+    do { rc = fstat(fd, &st); } while (rc < 0 && errno == EINTR);
+    if (rc == 0 && st.st_size != (off_t)bytes) {
+        do { rc = ftruncate(fd, (off_t)bytes); } while (rc < 0 && errno == EINTR);
+        /* O_SYNC already persisted the completed writes. Only a subsequent
+         * length change needs a separate barrier. */
+        if (rc == 0 && sync_write)
+            do { rc = fsync(fd); } while (rc < 0 && errno == EINTR);
+    }
+    close(fd);
+    return rc == 0 ? EFS_OK : EFS_ERR_IO;
+}
