     efs_client_rpc_set_deadline_ms(deadline);
     int rc = efs_client_rpc_past_deadline() ? -EAGAIN : efs_fuse_write_buf_run(path, buf, offset, fi);
+    rc = efs_fuse_sync_write_result(rc, fi);
     efs_client_rpc_set_deadline_ms(previous);
     return rc;
 }
