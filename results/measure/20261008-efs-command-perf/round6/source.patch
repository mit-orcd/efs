+static uint32_t node_hash(efs_ino_t ino)
+{
+    uint64_t x=ino;
+    x^=x>>30;x*=UINT64_C(0xbf58476d1ce4e5b9);
+    x^=x>>27;x*=UINT64_C(0x94d049bb133111eb);
+    x^=x>>31;return (uint32_t)x;
+}
