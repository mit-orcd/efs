diff --git a/include/efs/meta_apply.h b/include/efs/meta_apply.h
index f46347f7..ed1c8cb6 100644
--- a/include/efs/meta_apply.h
+++ b/include/efs/meta_apply.h
@@ -467,6 +467,14 @@ int efs_meta_apply_lookup(struct efs_kv *kv, efs_ino_t parent, const char *name,
 int efs_meta_apply_lookup_tx(struct efs_kv *kv, efs_ino_t parent,
                              const char *name, efs_txn_coord_fn coord,
                              void *ctx, struct efs_meta_dentry *out);
+/* Batched handler lookup with an already transaction-aware parent row. The
+ * caller MUST recheck generation, layout and layout_epoch before delivering
+ * the batch, refusing it if any changed. Dentry reads still resolve committed
+ * intents and respect split tombstones. Not a cross-request row cache. */
+int efs_meta_apply_lookup_row_tx(struct efs_kv *kv,
+                                 const struct efs_meta_row *parent_row,
+                                 const char *name, efs_txn_coord_fn coord,
+                                 void *ctx, struct efs_meta_dentry *out);
 /* LOOKUP + inode fetch. Dentry miss = NOT_FOUND; inode miss = I9 (IO). */
 int efs_meta_apply_resolve(struct efs_kv *kv, efs_ino_t parent, const char *name,
                            struct efs_meta_dentry *dent, struct efs_meta_row *row);
diff --git a/src/meta/meta_apply.c b/src/meta/meta_apply.c
index 5f440752..0906f364 100644
--- a/src/meta/meta_apply.c
+++ b/src/meta/meta_apply.c
@@ -698,7 +698,21 @@ static int lookup_at(struct efs_kv *kv, efs_ino_t parent, const char *name,
     }
     if (rc != EFS_OK)
         return rc;
-    if (prow.layout == EFS_META_LAYOUT_LOCAL)
+    return efs_meta_apply_lookup_row_tx(kv, &prow, name, coord, ctx, out);
+}
+
+int efs_meta_apply_lookup_row_tx(struct efs_kv *kv,
+                                 const struct efs_meta_row *parent_row,
+                                 const char *name, efs_txn_coord_fn coord,
+                                 void *ctx, struct efs_meta_dentry *out)
+{
+    if (!kv || !parent_row || !parent_row->ino || !name || !out ||
+        parent_row->layout > EFS_META_LAYOUT_HASHED)
+        return EFS_ERR_INVAL;
+    efs_ino_t parent = parent_row->ino;
+    uint32_t hsh;
+    int rc;
+    if (parent_row->layout == EFS_META_LAYOUT_LOCAL)
         return dent_get_tx(kv, efs_kv_inode_shard(parent), parent, name,
                            coord, ctx, out);
     hsh = efs_kv_dentry_shard(parent, name, EFS_META_LAYOUT_HASHED);
@@ -710,7 +724,7 @@ static int lookup_at(struct efs_kv *kv, efs_ino_t parent, const char *name,
     }
     if (rc != EFS_ERR_NOT_FOUND)
         return rc;
-    if (prow.layout == EFS_META_LAYOUT_HASHED)
+    if (parent_row->layout == EFS_META_LAYOUT_HASHED)
         return EFS_ERR_NOT_FOUND;
     return dent_get_tx(kv, efs_kv_inode_shard(parent), parent, name, coord,
                        ctx, out);
